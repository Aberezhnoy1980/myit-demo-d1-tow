+  --line: #D8D5CE;
+  --disabled-bg: #ECE9E2;
+  --disabled-ink: #5A6270;
+  --font: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
