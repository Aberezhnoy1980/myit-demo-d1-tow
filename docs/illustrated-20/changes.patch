+/* «Тяга» — единый файл настройки контактов.
+
+   Перед публикацией вписывайте только подтверждённые контакты.
+   Пустые значения оставляют страницу в демонстрационном состоянии:
+   главное действие — «Попробовать обращение» (черновик текста), кнопки связи отключены.
+
+   Состояния конфигурации:
+   - empty (оба null)          — демо-действие «Попробовать обращение»;
+   - phone-only / messenger-only / both — главное действие ведёт на настроенный контакт
+     (приоритет: телефон), отдельные кнопки связи становятся ссылками;
+   - invalid (неверный формат) — как empty, с предупреждением в консоли браузера.
+
+   Важно: «настроен» означает только техническую настройку ссылки. Это не доказательство
+   доставки сообщения и не признак действующего бизнеса. */
+
+window.DEMO_CONTACTS = {
+  // Подпись получателя — показывается у кнопок связи.
+  recipient: "Диспетчер «Тяга»",
+
+  // Телефон: строка вида "tel:+79000000000".
+  // Только реальный подтверждённый номер. Случайные номера не подставлять.
+  phone: null,
+
+  // Мессенджер: полный URL, например "https://wa.me/79000000000".
+  // Только реальный подтверждённый аккаунт. Чужие аккаунты не подставлять.
+  messenger: null
+};
